[user]
	name = dimitarkyurtov
	email = dimitarkiurtov@gmail.com

[alias]
	s        = status
	st       = status
	ci       = commit
	ca       = commit --amend
	co       = checkout
	br       = branch
	ad       = "!f(){ git ls-files --modified | xargs git add; };f"
	unstageall = reset HEAD --
	lg       = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	unpushed = log --branches --not --remotes --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative

[core]
	excludesfile = ~/.config/git/ignore

[credential]
	helper = osxkeychain
