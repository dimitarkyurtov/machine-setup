# Colors
theme = Cobalt2

# macOS
# macos-titlebar-style = hidden

# Shell Integration
# Disables cursor/title control but keeps other features like prompt marking
shell-integration-features = no-cursor,sudo,no-title

# Mouse & Interaction
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# Vim like scrolling
keybind = ctrl+u=scroll_page_fractional:-0.1
keybind = ctrl+d=scroll_page_fractional:0.1
keybind = ctrl+b=scroll_page_up
keybind = ctrl+f=scroll_page_down
keybind = ctrl+g=scroll_to_top
keybind = ctrl+shift+g=scroll_to_bottom
